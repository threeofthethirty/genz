{
  "name": "genz",
  "description": "Gen Z communication mode using a local slang reference index.",
  "author": {
    "name": "BrightLiteMedia",
    "url": "https://github.com/BrightLiteMedia"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/genz-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading Gen Z mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/genz-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking Gen Z mode..."
          }
        ]
      }
    ]
  }
}
